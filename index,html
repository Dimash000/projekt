<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Coffee</title>

	<style>
		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Poppins', sans-serif;
			background-color: #000;
			color: #fff;
		}

		.navbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 30px 10%;
			background-color: #000;
		}

		.logo {
			font-size: 28px;
			font-weight: 800;
		}

		.dot {
			color: #ff9800;
		}

		nav a {
			color: white;
			margin-left: 25px;
			text-decoration: none;
			font-weight: 400;
			transition: color 0.3s;
		}

		nav a:hover {
			color: #ff9800;
		}

		.hero {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 80px 10%;
			background-color: #000;
			flex-wrap: wrap;
		}

		.hero-text {
			max-width: 600px;
		}

		.hero-text h1 {
			font-size: 48px;
			font-weight: 800;
			margin-bottom: 20px;
			line-height: 1.3;
		}

		.hero-text .highlight {
			color: white;
		}

		.hero-text p {
			font-size: 16px;
			color: #bbb;
			margin-bottom: 30px;
			max-width: 500px;
		}

		.btn {
			display: inline-block;
			background-color: white;
			color: black;
			padding: 12px 24px;
			border-radius: 4px;
			text-decoration: none;
			font-weight: 600;
			transition: background-color 0.3s;
		}

		.btn:hover {
			background-color: #ddd;
		}

		.hero-img img {
			max-width: 400px;
			width: 100%;
			border-radius: 10px;
		}

		@media (max-width: 768px) {
			.hero {
				flex-direction: column;
				text-align: center;
			}

			.hero-img {
				margin-top: 30px;
			}
		}
	</style>
</head>

<body>

	<!-- Header -->
	<header class="navbar">
		<div class="logo">Coffee<span class="dot">.</span></div>
		<nav>
			<a href="#">Home</a>
			<a href="#">Product</a>
			<a href="#">Testimonials</a>
			<a href="#">About us</a>
			<a href="#">Contact us</a>
		</nav>
	</header>

	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-text">
			<h1>Start Your Day With<br><span class="highlight">Fresh Coffee</span></h1>
			<p>
				Coffee is a popular and beloved beverage enjoyed by people around the world.
				Awaken your senses with a steaming cup of liquid motivation.
			</p>
			<a href="#" class="btn">Order Now</a>
		</div>
		<div class="hero-img">
			<img src="7f6ed8cd-8d96-48ad-9417-c201e8375b90.jpg" alt="Coffee Cup" />
		</div>
	</section>

</body>

</html>